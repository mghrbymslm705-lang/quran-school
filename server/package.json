{
  "name": "quran-school-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --experimental-sqlite src/server.js",
    "dev": "node --watch --experimental-sqlite src/server.js",
    "seed": "node --experimental-sqlite src/seed-run.js",
    "backup": "node --experimental-sqlite scripts/backup.js",
    "restore": "node --experimental-sqlite scripts/backup.js restore",
    "setup-production": "node --experimental-sqlite scripts/setup-production.js",
    "test": "node --experimental-sqlite --test test/"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "supertest": "^7.0.0"
  }
}
