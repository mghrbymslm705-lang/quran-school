# ===== إعدادات النشر (انسخ هذا الملف إلى .env وعدّل القيم) =====
# لا تضع ملف .env ضمن مستودع المشروع (مضاف إلى .gitignore).

# الرابط الرسمي الثابت للتطبيق — يُستخدم في كل روابط المشاركة.
# يجب أن يكون اسم نطاق حقيقي (https)، ولا تستخدم localhost في الإنتاج.
APP_PUBLIC_URL=https://YOUR-DOMAIN.example

# بيئة التشغيل: اضبطها على production للنشر الحقيقي.
NODE_ENV=production

# منفذ الخادم.
PORT=4100

# رقم واتساب المشرف بصيغة دولية بدون علامة +.
WHATSAPP_NUMBER=212605706006

# مسار قاعدة البيانات الدائم — استخدم وحدة تخزين دائم (Persistent Volume) في الاستضافة
# حتى لا تُفقد البيانات عند إعادة التشغيل أو نشر تحديث. القيمة الافتراضية عند غيابه:
#   school.production.db بجوار الخادم (منفصلة عن قاعدة التطوير).
# DATABASE_PATH=/var/lib/quran-school/school.production.db

# سر توقيع JWT — أنشئ قيمة عشوائية طويلة وآمنة (مثال: openssl rand -base64 48).
# JWT_SECRET=replace-with-a-long-random-secret
